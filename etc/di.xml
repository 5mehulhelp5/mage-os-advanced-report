    <virtualType name="MageOS\AdvancedReport\Model\DataSource\Mysql\FieldExpression\BundleGrossSalesExpression" type="MageOS\AdvancedReport\Model\DataSource\Mysql\FieldExpression\DynamicBundleRollupExpression">
        <arguments>
            <argument name="lineExpression" xsi:type="string">(COALESCE(main.base_row_total, 0) * (1 - COALESCE(main.qty_canceled, 0) / COALESCE(NULLIF(main.qty_ordered, 0), 1)))</argument>
            <argument name="childrenExpression" xsi:type="string">COALESCE(main.base_row_total, 0) - COALESCE(SUM(COALESCE(bc.base_row_total, 0) * (1 - (1 - COALESCE(bc.qty_canceled, 0) / COALESCE(NULLIF(bc.qty_ordered, 0), 1)))), 0)</argument>
        </arguments>
    </virtualType>
    <virtualType name="MageOS\AdvancedReport\Model\DataSource\Mysql\FieldExpression\BundleDiscountExpression" type="MageOS\AdvancedReport\Model\DataSource\Mysql\FieldExpression\DynamicBundleRollupExpression">
        <arguments>
            <argument name="lineExpression" xsi:type="string">((ABS(COALESCE(main.base_discount_amount, 0)) - COALESCE(main.base_discount_tax_compensation_amount, 0)) * (1 - COALESCE(main.qty_canceled, 0) / COALESCE(NULLIF(main.qty_ordered, 0), 1)))</argument>
            <argument name="childrenExpression" xsi:type="string">COALESCE(SUM((ABS(COALESCE(bc.base_discount_amount, 0)) - COALESCE(bc.base_discount_tax_compensation_amount, 0)) * (1 - COALESCE(bc.qty_canceled, 0) / COALESCE(NULLIF(bc.qty_ordered, 0), 1))), 0)</argument>
        </arguments>
    </virtualType>
    <virtualType name="MageOS\AdvancedReport\Model\DataSource\Mysql\FieldExpression\BundleReturnsExpression" type="MageOS\AdvancedReport\Model\DataSource\Mysql\FieldExpression\DynamicBundleRollupExpression">
        <arguments>
            <argument name="lineExpression" xsi:type="string">(COALESCE(main.base_amount_refunded, 0) - (ABS(COALESCE(main.base_discount_refunded, 0)) - COALESCE(main.base_discount_tax_compensation_refunded, 0)))</argument>
            <argument name="childrenExpression" xsi:type="string">COALESCE(SUM(COALESCE(bc.base_amount_refunded, 0) - (ABS(COALESCE(bc.base_discount_refunded, 0)) - COALESCE(bc.base_discount_tax_compensation_refunded, 0))), 0)</argument>
        </arguments>
    </virtualType>
    <virtualType name="MageOS\AdvancedReport\Model\DataSource\Mysql\FieldExpression\BundleQtyNetExpression" type="MageOS\AdvancedReport\Model\DataSource\Mysql\FieldExpression\DynamicBundleRollupExpression">
        <arguments>
            <argument name="lineExpression" xsi:type="string">(COALESCE(main.qty_ordered, 0) - COALESCE(main.qty_canceled, 0))</argument>
            <argument name="childrenExpression" xsi:type="string">COALESCE(main.qty_ordered, 0) * (1 - COALESCE(MAX(COALESCE(bc.qty_canceled, 0) / COALESCE(NULLIF(bc.qty_ordered, 0), 1)), 0))</argument>
        </arguments>
    </virtualType>
