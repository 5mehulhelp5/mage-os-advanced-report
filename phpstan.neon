includes:
    - vendor/bitexpert/phpstan-magento/extension.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
parameters:
    level: 8
    paths:
        - Api
        - Console
        - Controller
        - Model
        - Observer
        - ViewModel
        - Test
    excludePaths:
        - Test/Integration
    treatPhpDocTypesAsCertain: false
    parallel:
        maximumNumberOfProcesses: 1
